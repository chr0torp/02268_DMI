<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Advisory" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:message id="Message_AdviceRequest" name="Advice request" />
  <bpmn:message id="Message_Declined" name="Decline / referral" />
  <bpmn:message id="Message_ScopeProposal" name="Scope &amp; deadline proposal" />
  <bpmn:message id="Message_ScopeConfirmed" name="Scope &amp; deadline confirmation" />
  <bpmn:message id="Message_Advice" name="Advice" />
  <bpmn:message id="Message_Klimastatus" name="Klimastatus report" />
  <bpmn:dataStore id="DataStore_Knowledge" name="Climate knowledge base" />
  <bpmn:dataStore id="DataStore_Observations" name="Observations &amp; model output" />
  <bpmn:collaboration id="Collaboration_Advisory">
    <bpmn:participant id="Participant_Government" name="Government (ministries &amp; authorities)" processRef="Process_Government" />
    <bpmn:participant id="Participant_DMI" name="DMI – National Centre for Climate Research (NCKF)" processRef="Process_Advisory" />
    <bpmn:participant id="Participant_Audience" name="Policymakers, researchers &amp; public" />
    <bpmn:messageFlow id="MessageFlow_Request" name="Advice request" sourceRef="Activity_RequestAdvice" targetRef="Event_RequestReceived" />
    <bpmn:messageFlow id="MessageFlow_Declined" name="Decline / referral" sourceRef="Event_RequestDeclined" targetRef="Event_DeclinedReceived" />
    <bpmn:messageFlow id="MessageFlow_Proposal" name="Scope &amp; deadline proposal" sourceRef="Activity_ProposeScope" targetRef="Event_ProposalReceived" />
    <bpmn:messageFlow id="MessageFlow_Confirm" name="Confirmation" sourceRef="Activity_ConfirmScope" targetRef="Event_ScopeConfirmed" />
    <bpmn:messageFlow id="MessageFlow_Advice" name="Advice" sourceRef="Event_AdviceSent" targetRef="Event_AdviceReceived" />
    <bpmn:messageFlow id="MessageFlow_Klimastatus" name="Klimastatus report" sourceRef="Event_KlimastatusPublished" targetRef="Participant_Audience" />
  </bpmn:collaboration>
  <!-- Requester: ministries and authorities -->
  <bpmn:process id="Process_Government" isExecutable="false">
    <bpmn:startEvent id="Event_AdviceNeeded" name="Advice needed">
      <bpmn:outgoing>Flow_G1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_RequestAdvice" name="Request advice from DMI" messageRef="Message_AdviceRequest">
      <bpmn:incoming>Flow_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_AwaitResponse">
      <bpmn:incoming>Flow_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_DeclinedReceived" name="Request declined">
      <bpmn:incoming>Flow_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_DeclinedReceived" messageRef="Message_Declined" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_SoughtElsewhere" name="Advice sought elsewhere">
      <bpmn:incoming>Flow_G5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_ProposalReceived" name="Scope &amp; deadline proposed">
      <bpmn:incoming>Flow_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ProposalReceived" messageRef="Message_ScopeProposal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Activity_ConfirmScope" name="Confirm scope and deadline" messageRef="Message_ScopeConfirmed">
      <bpmn:incoming>Flow_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_G7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_AdviceReceived" name="Advice received">
      <bpmn:incoming>Flow_G7</bpmn:incoming>
      <bpmn:outgoing>Flow_G8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_AdviceReceived" messageRef="Message_Advice" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_DecisionBasis" name="Decision basis obtained">
      <bpmn:incoming>Flow_G8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_G1" sourceRef="Event_AdviceNeeded" targetRef="Activity_RequestAdvice" />
    <bpmn:sequenceFlow id="Flow_G2" sourceRef="Activity_RequestAdvice" targetRef="Gateway_AwaitResponse" />
    <bpmn:sequenceFlow id="Flow_G3" sourceRef="Gateway_AwaitResponse" targetRef="Event_ProposalReceived" />
    <bpmn:sequenceFlow id="Flow_G4" sourceRef="Gateway_AwaitResponse" targetRef="Event_DeclinedReceived" />
    <bpmn:sequenceFlow id="Flow_G5" sourceRef="Event_DeclinedReceived" targetRef="Event_SoughtElsewhere" />
    <bpmn:sequenceFlow id="Flow_G6" sourceRef="Event_ProposalReceived" targetRef="Activity_ConfirmScope" />
    <bpmn:sequenceFlow id="Flow_G7" sourceRef="Activity_ConfirmScope" targetRef="Event_AdviceReceived" />
    <bpmn:sequenceFlow id="Flow_G8" sourceRef="Event_AdviceReceived" targetRef="Event_DecisionBasis" />
  </bpmn:process>
  <!-- DMI / NCKF -->
  <bpmn:process id="Process_Advisory" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DMI">
      <bpmn:lane id="Lane_Advisory" name="Advisory">
        <bpmn:flowNodeRef>Event_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AssessRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Mandate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RequestDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ProposeScope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ScopeConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Knowledge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdviceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PrepareAdvice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AdviceSent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Research" name="Research">
        <bpmn:flowNodeRef>Event_YearlyCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CompileKlimastatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_KlimastatusPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TargetedAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_DeadlineReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SummarisePreliminary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnalysisMerge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DataStoreReference_KnowledgeAdvice" name="Climate knowledge base" dataStoreRef="DataStore_Knowledge" />
    <bpmn:dataStoreReference id="DataStoreReference_KnowledgeAnalysis" name="Climate knowledge base" dataStoreRef="DataStore_Knowledge" />
    <bpmn:dataStoreReference id="DataStoreReference_ObsAnalysis" name="Observations &amp; model output" dataStoreRef="DataStore_Observations" />
    <bpmn:dataStoreReference id="DataStoreReference_KnowledgeKlimastatus" name="Climate knowledge base" dataStoreRef="DataStore_Knowledge" />
    <bpmn:dataStoreReference id="DataStoreReference_ObsKlimastatus" name="Observations &amp; model output" dataStoreRef="DataStore_Observations" />
    <!-- Advice on request -->
    <bpmn:startEvent id="Event_RequestReceived" name="Advice request received">
      <bpmn:outgoing>Flow_D1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RequestReceived" messageRef="Message_AdviceRequest" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_AssessRequest" name="Assess request">
      <bpmn:incoming>Flow_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Mandate" name="Within DMI's mandate?">
      <bpmn:incoming>Flow_D2</bpmn:incoming>
      <bpmn:outgoing>Flow_D3</bpmn:outgoing>
      <bpmn:outgoing>Flow_D4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_RequestDeclined" name="Request declined / referred">
      <bpmn:incoming>Flow_D3</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RequestDeclined" messageRef="Message_Declined" />
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_ProposeScope" name="Propose scope and deadline" messageRef="Message_ScopeProposal">
      <bpmn:incoming>Flow_D4</bpmn:incoming>
      <bpmn:outgoing>Flow_D5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ScopeConfirmed" name="Scope &amp; deadline confirmed">
      <bpmn:incoming>Flow_D5</bpmn:incoming>
      <bpmn:outgoing>Flow_D6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ScopeConfirmed" messageRef="Message_ScopeConfirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Knowledge" name="Existing knowledge sufficient?">
      <bpmn:incoming>Flow_D6</bpmn:incoming>
      <bpmn:outgoing>Flow_D7</bpmn:outgoing>
      <bpmn:outgoing>Flow_D8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_TargetedAnalysis" name="Perform targeted analysis">
      <bpmn:incoming>Flow_D8</bpmn:incoming>
      <bpmn:outgoing>Flow_D9</bpmn:outgoing>
      <bpmn:property id="Property_TargetedAnalysis" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_AnalysisKnowledge">
        <bpmn:sourceRef>DataStoreReference_KnowledgeAnalysis</bpmn:sourceRef>
        <bpmn:targetRef>Property_TargetedAnalysis</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_AnalysisObs">
        <bpmn:sourceRef>DataStoreReference_ObsAnalysis</bpmn:sourceRef>
        <bpmn:targetRef>Property_TargetedAnalysis</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Event_DeadlineReached" name="Deadline reached" attachedToRef="Activity_TargetedAnalysis">
      <bpmn:outgoing>Flow_D10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Deadline" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Activity_SummarisePreliminary" name="Summarise preliminary results">
      <bpmn:incoming>Flow_D10</bpmn:incoming>
      <bpmn:outgoing>Flow_D11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AnalysisMerge">
      <bpmn:incoming>Flow_D9</bpmn:incoming>
      <bpmn:incoming>Flow_D11</bpmn:incoming>
      <bpmn:outgoing>Flow_D12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AdviceMerge">
      <bpmn:incoming>Flow_D7</bpmn:incoming>
      <bpmn:incoming>Flow_D12</bpmn:incoming>
      <bpmn:incoming>Flow_D17</bpmn:incoming>
      <bpmn:outgoing>Flow_D13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_PrepareAdvice" name="Prepare advice">
      <bpmn:incoming>Flow_D13</bpmn:incoming>
      <bpmn:outgoing>Flow_D14</bpmn:outgoing>
      <bpmn:property id="Property_PrepareAdvice" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_PrepareKnowledge">
        <bpmn:sourceRef>DataStoreReference_KnowledgeAdvice</bpmn:sourceRef>
        <bpmn:targetRef>Property_PrepareAdvice</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Activity_QualityCheck" name="Quality-check and sign off">
      <bpmn:incoming>Flow_D14</bpmn:incoming>
      <bpmn:outgoing>Flow_D15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_D15</bpmn:incoming>
      <bpmn:outgoing>Flow_D16</bpmn:outgoing>
      <bpmn:outgoing>Flow_D17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_AdviceSent" name="Advice sent">
      <bpmn:incoming>Flow_D16</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_AdviceSent" messageRef="Message_Advice" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_D1" sourceRef="Event_RequestReceived" targetRef="Activity_AssessRequest" />
    <bpmn:sequenceFlow id="Flow_D2" sourceRef="Activity_AssessRequest" targetRef="Gateway_Mandate" />
    <bpmn:sequenceFlow id="Flow_D3" name="No" sourceRef="Gateway_Mandate" targetRef="Event_RequestDeclined" />
    <bpmn:sequenceFlow id="Flow_D4" name="Yes" sourceRef="Gateway_Mandate" targetRef="Activity_ProposeScope" />
    <bpmn:sequenceFlow id="Flow_D5" sourceRef="Activity_ProposeScope" targetRef="Event_ScopeConfirmed" />
    <bpmn:sequenceFlow id="Flow_D6" sourceRef="Event_ScopeConfirmed" targetRef="Gateway_Knowledge" />
    <bpmn:sequenceFlow id="Flow_D7" name="Yes" sourceRef="Gateway_Knowledge" targetRef="Gateway_AdviceMerge" />
    <bpmn:sequenceFlow id="Flow_D8" name="No" sourceRef="Gateway_Knowledge" targetRef="Activity_TargetedAnalysis" />
    <bpmn:sequenceFlow id="Flow_D9" sourceRef="Activity_TargetedAnalysis" targetRef="Gateway_AnalysisMerge" />
    <bpmn:sequenceFlow id="Flow_D10" sourceRef="Event_DeadlineReached" targetRef="Activity_SummarisePreliminary" />
    <bpmn:sequenceFlow id="Flow_D11" sourceRef="Activity_SummarisePreliminary" targetRef="Gateway_AnalysisMerge" />
    <bpmn:sequenceFlow id="Flow_D12" sourceRef="Gateway_AnalysisMerge" targetRef="Gateway_AdviceMerge" />
    <bpmn:sequenceFlow id="Flow_D13" sourceRef="Gateway_AdviceMerge" targetRef="Activity_PrepareAdvice" />
    <bpmn:sequenceFlow id="Flow_D14" sourceRef="Activity_PrepareAdvice" targetRef="Activity_QualityCheck" />
    <bpmn:sequenceFlow id="Flow_D15" sourceRef="Activity_QualityCheck" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_D16" name="Yes" sourceRef="Gateway_Approved" targetRef="Event_AdviceSent" />
    <bpmn:sequenceFlow id="Flow_D17" name="No (rework)" sourceRef="Gateway_Approved" targetRef="Gateway_AdviceMerge" />
    <!-- Yearly Klimastatus (NCKF) -->
    <bpmn:startEvent id="Event_YearlyCycle" name="Yearly Klimastatus cycle">
      <bpmn:outgoing>Flow_K1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Yearly">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1Y</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Activity_CompileKlimastatus" name="Compile Klimastatus report">
      <bpmn:incoming>Flow_K1</bpmn:incoming>
      <bpmn:outgoing>Flow_K2</bpmn:outgoing>
      <bpmn:property id="Property_CompileKlimastatus" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_KlimastatusObs">
        <bpmn:sourceRef>DataStoreReference_ObsKlimastatus</bpmn:sourceRef>
        <bpmn:targetRef>Property_CompileKlimastatus</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_KlimastatusKnowledge">
        <bpmn:sourceRef>DataStoreReference_KnowledgeKlimastatus</bpmn:sourceRef>
        <bpmn:targetRef>Property_CompileKlimastatus</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="Event_KlimastatusPublished" name="Klimastatus published">
      <bpmn:incoming>Flow_K2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Klimastatus" messageRef="Message_Klimastatus" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_K1" sourceRef="Event_YearlyCycle" targetRef="Activity_CompileKlimastatus" />
    <bpmn:sequenceFlow id="Flow_K2" sourceRef="Activity_CompileKlimastatus" targetRef="Event_KlimastatusPublished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Advisory">
    <bpmndi:BPMNPlane id="BPMNPlane_Advisory" bpmnElement="Collaboration_Advisory">
      <!-- Pools and lanes -->
      <bpmndi:BPMNShape id="Participant_Government_di" bpmnElement="Participant_Government" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1760" height="220" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_DMI_di" bpmnElement="Participant_DMI" isHorizontal="true">
        <dc:Bounds x="160" y="290" width="1760" height="610" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Advisory_di" bpmnElement="Lane_Advisory" isHorizontal="true">
        <dc:Bounds x="190" y="290" width="1730" height="310" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Research_di" bpmnElement="Lane_Research" isHorizontal="true">
        <dc:Bounds x="190" y="600" width="1730" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Audience_di" bpmnElement="Participant_Audience" isHorizontal="true">
        <dc:Bounds x="160" y="930" width="1760" height="60" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <!-- Government process -->
      <bpmndi:BPMNShape id="Event_AdviceNeeded_di" bpmnElement="Event_AdviceNeeded">
        <dc:Bounds x="232" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="215" y="135" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RequestAdvice_di" bpmnElement="Activity_RequestAdvice">
        <dc:Bounds x="300" y="70" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AwaitResponse_di" bpmnElement="Gateway_AwaitResponse">
        <dc:Bounds x="445" y="85" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_DeclinedReceived_di" bpmnElement="Event_DeclinedReceived">
        <dc:Bounds x="572" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="163" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_SoughtElsewhere_di" bpmnElement="Event_SoughtElsewhere">
        <dc:Bounds x="642" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="624" y="225" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ProposalReceived_di" bpmnElement="Event_ProposalReceived">
        <dc:Bounds x="692" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="58" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ConfirmScope_di" bpmnElement="Activity_ConfirmScope">
        <dc:Bounds x="790" y="70" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_AdviceReceived_di" bpmnElement="Event_AdviceReceived">
        <dc:Bounds x="1722" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1700" y="70" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_DecisionBasis_di" bpmnElement="Event_DecisionBasis">
        <dc:Bounds x="1812" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1794" y="135" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_G1_di" bpmnElement="Flow_G1">
        <di:waypoint x="268" y="110" />
        <di:waypoint x="300" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G2_di" bpmnElement="Flow_G2">
        <di:waypoint x="400" y="110" />
        <di:waypoint x="445" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G3_di" bpmnElement="Flow_G3">
        <di:waypoint x="495" y="110" />
        <di:waypoint x="692" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G4_di" bpmnElement="Flow_G4">
        <di:waypoint x="470" y="135" />
        <di:waypoint x="470" y="200" />
        <di:waypoint x="572" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G5_di" bpmnElement="Flow_G5">
        <di:waypoint x="608" y="200" />
        <di:waypoint x="642" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G6_di" bpmnElement="Flow_G6">
        <di:waypoint x="728" y="110" />
        <di:waypoint x="790" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G7_di" bpmnElement="Flow_G7">
        <di:waypoint x="890" y="110" />
        <di:waypoint x="1722" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_G8_di" bpmnElement="Flow_G8">
        <di:waypoint x="1758" y="110" />
        <di:waypoint x="1812" y="110" />
      </bpmndi:BPMNEdge>
      <!-- DMI: advice on request -->
      <bpmndi:BPMNShape id="Event_RequestReceived_di" bpmnElement="Event_RequestReceived">
        <dc:Bounds x="332" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="312" y="465" width="77" height="27" />
