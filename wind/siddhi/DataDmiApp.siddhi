@App:name("DataDmiApp")

/* -----------------------------
   INPUT STREAMS
   ----------------------------- */

@source(
    type='http',
    receiver.url="http://0.0.0.0:7071/dmi",
    @map(type='json', fail.on.missing.attribute='false')
)
define stream Stream(id string, parameterId string, mean_wind_speed float, wind_gust float, rain float, stationId string, snow float, area string, waterlevel float);

@source(
    type='http',
    receiver.url="http://0.0.0.0:7072/middleman",
    @map(type='json')
)

define stream MiddlemanStream(
    id string,
    parameterId string,
    stationId string,
    warning string,
    event string,
    timestamp string,
    payload string,
    error string
);


/* -----------------------------
   CAMUNDA COMMAND OUTPUTS
   ----------------------------- */

@sink(
    type='http',
    publisher.url='http://communication:5001/wind_data',
    method='POST',
    @map(type='json')
)
define stream WindDataInput(
    id string,
    parameterId string,
    mean_wind_speed float,
    wind_gust float,
    stationId string
);

@sink(
    type='http',
    publisher.url='http://communication:5001/cloudburst_data',
    method='POST',
    @map(type='json')
)
define stream CloudBurstDataInput(
    id string,
    parameterId string,
    rain float,
    stationId string  
);

@sink(
    type='http',
    publisher.url='http://communication:5001/snow_data',
    method='POST',
    @map(type='json')
)
define stream SnowDataInput(
    id string,
    parameterId string,
    snow float,
    stationId string  
);

@sink(
    type='http',
    publisher.url='http://communication:5001/waterlevel_data',
    method='POST',
    @map(type='json')
)
define stream WaterlevelDataInput(
    id string,
    parameterId string,
    waterlevel float,
    area string,
    stationId string 
);


/* -----------------------------
   LOGGER OUTPUT
   ----------------------------- */

@sink(
    type='http',
    publisher.url='http://logging-service:5010/log',
    method='POST',
    @map(type='json')
)
define stream Logging(
    id string,
    stationId string,
    parameterId string,
    mean_wind_speed float, 
    wind_gust float,
    rain float,
    snow float,
    waterlevel float,
    area string
);

@sink(
    type='http',
    publisher.url='http://logging-service:5010/log',
    method='POST',
    @map(type='json')
)
define stream CallbackLog(
    id string,
    parameterId string,
    warning string,
    event string,
    timestamp string,
    payload string,
    error string
);

define stream RoutingError(
    id string,
    error string
);


/* -----------------------------
   AUTHORITY WARNING SINKS & STATE
   ----------------------------- */

@sink(
    type='http',
    publisher.url='http://communication:5001/authority_warning',
    method='POST',
    @map(type='json')
)
define stream AuthorityWarningInput(
    id string,
    parameterId string,
    stationId string,
    severity int
);

@sink(
    type='http',
    publisher.url='http://communication:5001/authority_warning_update',
    method='POST',
    @map(type='json')
)
define stream AuthorityWarningUpdateInput(
    id string,
    parameterId string,
    stationId string,
    severity int
);

@primaryKey('stationId')
define table ActiveWarningsTable(stationId string, active bool);

/* Map warning category from Camunda callbacks into severity 1, 2, or 3 */
from MiddlemanStream[
    not(stationId is null) and (
        event == "WindWarning" or
        event == "CloudburstWarning" or
        event == "SnowWarning" or
        event == "WaterLevelWarning"
    )
]
select
    id,
    parameterId,
    stationId,
    ifThenElse(warning == "Category 3", 3,
        ifThenElse(warning == "Category 2", 2,
            ifThenElse(warning == "Category 1", 1, 0)
        )
    ) as severity
insert into DerivedSeverityStream;

/* Emit severity = 0 if a received event finishes without issuing a warning within 2s */
from every e1 = MiddlemanStream[
    not(stationId is null) and (
        event == "WindDataReceived" or
        event == "CloudburstDataReceived" or
        event == "SnowDataReceived" or
        event == "WaterLevelDataReceived"
    )
] -> not MiddlemanStream[
    id == e1.id and (
        event == "WindWarning" or
        event == "CloudburstWarning" or
        event == "SnowWarning" or
        event == "WaterLevelWarning"
    )
] for 2 sec
select
    e1.id as id,
    e1.parameterId as parameterId,
    e1.stationId as stationId,
    0 as severity
insert into DerivedSeverityStream;

/* Start Process_authority_warning if station is not active and severity >= 1 */
from DerivedSeverityStream[severity >= 1 and not((stationId == ActiveWarningsTable.stationId) in ActiveWarningsTable)]
select id, parameterId, stationId, severity
insert into AuthorityWarningInput;

/* Update or dewarn active Process_authority_warning instance */
from DerivedSeverityStream[(stationId == ActiveWarningsTable.stationId) in ActiveWarningsTable]
select id, parameterId, stationId, severity
insert into AuthorityWarningUpdateInput;

/* Update ActiveWarningsTable state AFTER routing */
from DerivedSeverityStream[severity >= 1 and not((stationId == ActiveWarningsTable.stationId) in ActiveWarningsTable)]
select stationId, true as active
update or insert into ActiveWarningsTable
    set ActiveWarningsTable.active = active
    on ActiveWarningsTable.stationId == stationId;

from DerivedSeverityStream[severity == 0 and ((stationId == ActiveWarningsTable.stationId) in ActiveWarningsTable)]
delete ActiveWarningsTable
    on ActiveWarningsTable.stationId == stationId;

/* -----------------------------
   DMI EVENT ROUTING
   ----------------------------- */

from Stream[not(id is null)]
select id, stationId, parameterId, mean_wind_speed, wind_gust, rain, snow, waterlevel, area
insert into Logging;

from Stream[parameterId == "wind_data" and not(id is null)]
select id, parameterId, mean_wind_speed, wind_gust, stationId
insert into WindDataInput;

from Stream[parameterId == "cloudburst_data" and not(id is null)]
select id, parameterId, rain, stationId
insert into CloudBurstDataInput;

from Stream[parameterId == "snow_data" and not(id is null)]
select id, parameterId, snow, stationId
insert into SnowDataInput;

from Stream[parameterId == "waterlevel_data" and not(id is null)]
select id, parameterId, waterlevel, area, stationId
insert into WaterlevelDataInput;

from MiddlemanStream
select id, parameterId, warning, event, timestamp, payload, error
insert into CallbackLog;
